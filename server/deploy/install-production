#!/usr/bin/env bash
set -euo pipefail

candidate_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
production_dir="$HOME/andy/andy-server-production"
rollback_dir="$HOME/andy/andy-server-rollback"
user_unit_dir="$HOME/.config/systemd/user"
uv_bin="$HOME/.local/bin/uv"

if [[ "$candidate_dir" != $HOME/andy/andy-server-candidate ]]; then
  printf 'Installer must run from the isolated candidate directory: %s\n' \
    "$candidate_dir" >&2
  exit 1
fi

for command_name in curl grep install jq systemctl; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    printf 'Required command is unavailable: %s\n' "$command_name" >&2
    exit 1
  fi
done
if [[ ! -x "$uv_bin" ]]; then
  printf 'uv is unavailable: %s\n' "$uv_bin" >&2
  exit 1
fi
for required_file in .env pyproject.toml uv.lock deploy/andy-server.service; do
  if [[ ! -f "${candidate_dir}/${required_file}" ]]; then
    printf 'Candidate is missing %s.\n' "$required_file" >&2
    exit 1
  fi
done

# Permitted but allowed to be empty: a list of MCP servers is often none.
optional_environment_keys=(
  ANDY_MCP_SERVERS
  ANDY_ASR_MODEL
  ANDY_OWL_URL
)

environment_keys=(
  ANDY_DEVICE_ENABLED
  ANDY_DEVICE_HOST
  ANDY_DEVICE_PORT
  ANDY_DEVICE_NAME
  ANDY_DEVICE_PROJECT
  ANDY_DEVICE_MAC
  ANDY_DEVICE_KEY
  ANDY_MOTION_ACTIONS_ENABLED
  ANDY_MEDIA_BASE_URL
  ANDY_ASR_URL
  ANDY_ASR_API
  ANDY_ASR_LANGUAGE
  ANDY_TTS_URL
  ANDY_TTS_VOICE
  ANDY_LLM_URL
  ANDY_LLM_MODEL
  ANDY_LLM_REASONING
  ANDY_SYSTEM_PROMPT
  ANDY_AGENT_ENABLED
  ANDY_VISION_ENABLED
  ANDY_VLM_URL
  ANDY_VLM_MODEL
  ANDY_VAD_ENGINE
  ANDY_VAD_SPEECH_THRESHOLD
  ANDY_VAD_MIN_SPEECH_RMS
  ANDY_VAD_NOISE_RATIO
  ANDY_SESSION_IDLE_SECONDS
  ANDY_STATE_DIR
  OLLAMA_API_KEY
)
declare -A environment_seen=()
while IFS= read -r environment_line || [[ -n "$environment_line" ]]; do
  if [[ -z "$environment_line" ]]; then
    continue
  fi
  environment_key="${environment_line%%=*}"
  case "$environment_key" in
    ANDY_DEVICE_ENABLED|ANDY_DEVICE_HOST|ANDY_DEVICE_PORT|ANDY_DEVICE_NAME|\
    ANDY_DEVICE_PROJECT|ANDY_DEVICE_MAC|ANDY_DEVICE_KEY|\
    ANDY_MOTION_ACTIONS_ENABLED|ANDY_MEDIA_BASE_URL|ANDY_ASR_URL|\
    ANDY_ASR_API|ANDY_ASR_MODEL|ANDY_ASR_LANGUAGE|\
    ANDY_TTS_URL|ANDY_TTS_VOICE|ANDY_LLM_URL|ANDY_LLM_MODEL|\
    ANDY_LLM_REASONING|ANDY_SYSTEM_PROMPT|ANDY_AGENT_ENABLED|\
    ANDY_VISION_ENABLED|ANDY_VLM_URL|ANDY_VLM_MODEL|ANDY_OWL_URL|\
    ANDY_MCP_SERVERS|\
    ANDY_VAD_ENGINE|ANDY_VAD_SPEECH_THRESHOLD|\
    ANDY_VAD_MIN_SPEECH_RMS|ANDY_VAD_NOISE_RATIO|ANDY_SESSION_IDLE_SECONDS|\
    ANDY_STATE_DIR|OLLAMA_API_KEY)
      environment_seen["$environment_key"]=$((
        ${environment_seen["$environment_key"]:-0} + 1
      ))
      ;;
    *)
      printf 'Candidate environment contains an unsupported key: %s\n' \
        "$environment_key" >&2
      exit 1
      ;;
  esac
done <"${candidate_dir}/.env"

for environment_key in "${environment_keys[@]}"; do
  if [[ "${environment_seen[$environment_key]:-0}" != 1 ]] || \
     ! grep -Eq "^${environment_key}=.+$" "${candidate_dir}/.env"; then
    printf 'Candidate environment must contain one non-empty %s value.\n' \
      "$environment_key" >&2
    exit 1
  fi
done

for environment_key in "${optional_environment_keys[@]}"; do
  if [[ "${environment_seen[$environment_key]:-0}" != 1 ]]; then
    printf 'Candidate environment must contain exactly one %s line.\n' \
      "$environment_key" >&2
    exit 1
  fi
done
chmod 0600 "${candidate_dir}/.env"

python_source="${production_dir}/.uv-python"
if [[ -d "$python_source" ]]; then
  rm -rf -- "${candidate_dir}/.uv-python"
  cp -a -- "$python_source" "${candidate_dir}/.uv-python"
fi
if [[ -d "${production_dir}/.uv-cache" ]]; then
  cp -a -- "${production_dir}/.uv-cache" "${candidate_dir}/.uv-cache"
fi

sync_environment() {
  local project_dir="$1"

  if ! UV_CACHE_DIR="${project_dir}/.uv-cache" \
    UV_PYTHON_INSTALL_DIR="${project_dir}/.uv-python" \
    UV_PROJECT_ENVIRONMENT="${project_dir}/.venv" \
    UV_MANAGED_PYTHON=1 \
      "$uv_bin" sync \
        --project "$project_dir" \
        --python 3.12 \
        --frozen \
        --no-dev \
        --no-editable; then
    return 1
  fi

  PYTHONDONTWRITEBYTECODE=1 "${project_dir}/.venv/bin/python" -c \
    'import sys; import andy; assert sys.version_info[:2] == (3, 12); assert andy.__version__ == "0.5.0"'
}

expected_media_base_url="$(
  sed -n 's/^ANDY_MEDIA_BASE_URL=//p' "${candidate_dir}/.env"
)"
if [[ -z "$expected_media_base_url" ]]; then
  printf 'Candidate environment has no ANDY_MEDIA_BASE_URL to verify against.\n' >&2
  exit 1
fi

production_ready() {
  curl --fail --silent --show-error --max-time 3 \
    http://127.0.0.1:8900/health \
    | jq -e --arg media_base_url "$expected_media_base_url" \
      '.ok and .version == "0.5.0"
       and .media_base_url == $media_base_url
       and .asr and .tts and .llm
       and .device_connected and .motion_actions_enabled and .motion_ready' \
      >/dev/null \
    && curl --fail --silent --show-error --max-time 3 \
      http://127.0.0.1:8900/motions \
      | jq -e \
        '(.motions | length) == 13
         and any(.motions[]; .name == "dance" and (.steps | length) == 8)' \
        >/dev/null
}

rollback_ready() {
  curl --fail --silent --show-error --max-time 3 \
    http://127.0.0.1:8900/health \
    | jq -e \
      '.ok and .version == "0.5.0" and .device_connected and .motion_ready' \
      >/dev/null
}

restore_previous() {
  systemctl --user stop andy-server.service 2>/dev/null || true
  rm -rf -- "$production_dir"
  if [[ -d "$rollback_dir" ]]; then
    mv -- "$rollback_dir" "$production_dir"
    systemctl --user enable andy-server.service >/dev/null
    systemctl --user restart andy-server.service
    for ((attempt = 1; attempt <= 20; attempt++)); do
      if rollback_ready; then
        return 0
      fi
      sleep 1
    done
  fi
  return 1
}

if ! sync_environment "$candidate_dir"; then
  printf 'Candidate Python environment failed validation.\n' >&2
  exit 1
fi

mkdir -p -- "$user_unit_dir"
install -m 0644 \
  "${candidate_dir}/deploy/andy-server.service" \
  "${user_unit_dir}/andy-server.service"
systemctl --user daemon-reload
systemctl --user stop andy-server.service 2>/dev/null || true

rm -rf -- "$rollback_dir"
if [[ -d "$production_dir" ]]; then
  mv -- "$production_dir" "$rollback_dir"
fi
mv -- "$candidate_dir" "$production_dir"
rm -rf -- "${production_dir}/.venv"
if ! sync_environment "$production_dir"; then
  if restore_previous; then
    printf 'Final-path environment failed; production was restored.\n' >&2
  else
    printf 'Final-path environment failed and recovery is not healthy.\n' >&2
  fi
  exit 1
fi
systemctl --user enable andy-server.service >/dev/null
systemctl --user restart andy-server.service

for ((attempt = 1; attempt <= 30; attempt++)); do
  if production_ready; then
    rm -rf -- "$rollback_dir" "${production_dir}/.uv-cache"
    printf 'Andy production server is ready on port 8900.\n'
    exit 0
  fi
  sleep 1
done

if restore_previous; then
  printf 'Production health failed; the preceding release was restored.\n' >&2
else
  printf 'Production health failed and automatic recovery is not healthy.\n' >&2
fi
exit 1
