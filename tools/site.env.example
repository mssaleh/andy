# Copy to tools/site.env and set the values for your own installation.
# tools/site.env is untracked; nothing here belongs in a public repository.

# The robot, on your LAN, for OTA and recovery.
ANDY_DEVICE_HOST=192.0.2.10
# The robot's Wi-Fi MAC. Deployment refuses to flash anything else.
ANDY_DEVICE_MAC=AA:BB:CC:DD:EE:FF

# The machine running the agent server.
ANDY_SERVER_HOST=192.0.2.20
ANDY_VOICE_SERVER_URL=http://192.0.2.20:8900
ANDY_TTS_URL=http://192.0.2.20:8880
ANDY_ASR_URL=http://192.0.2.20:8881
ANDY_DIAGNOSTIC_SSH_HOST=192.0.2.20

# Where the server is installed on that machine.
ANDY_REMOTE_HOME=/home/youruser
